# ─── resQ 2.0 configuration ───────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# App
APP_ENV=dev
USE_MOCKS=1                 # 1 = mock Kapture create / PubSub / payments; 0 = real
LOG_LEVEL=INFO

# Database (Postgres via docker-compose, or sqlite for quick local runs)
DATABASE_URL=postgresql+asyncpg://resq:resq@localhost:5432/resq
# DATABASE_URL=sqlite+aiosqlite:///./resq.sqlite3

# ─── Kapture REST (ledger) — LIVE UAT access provided ──────────────────────
KAPTURE_BASE_URL=https://resqplatform.prep.ril.com/api
KAPTURE_CREDENTIAL_ID=kapture
KAPTURE_SECRET_KEY=uiojy23ftrghysf5
# PENDING from middleware team — HMAC-SHA256 key for the two create APIs:
KAPTURE_CHECKSUM_KEY=
# TLS: leave empty on a clean server (uses certifi). Behind a TLS-inspecting SASE
# proxy (Check Point Harmony etc.), run scripts/make_ca_bundle.sh and set the path:
KAPTURE_CA_BUNDLE=
KAPTURE_VERIFY_SSL=1

# ─── GCP Pub/Sub (service-order events) — PENDING SA key ───────────────────
GCP_PROJECT_ID=sr-prj-rrl-retail-release-resq
PUBSUB_SUBSCRIPTION=fynd-hackathon-sub
GOOGLE_APPLICATION_CREDENTIALS=

# ─── WhatsApp Cloud API — PENDING numbers/token ────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=resq-verify
WHATSAPP_API_VERSION=v21.0
# phone_number_id for each of the 4 roles (section 2.1)
WA_PHONE_ID_CUSTOMER=
WA_PHONE_ID_OWNER=
WA_PHONE_ID_FIELD=
WA_PHONE_ID_AREA=

# ─── Anthropic (the agent) ─────────────────────────────────────────────────
# LLM: Claude preferred; if only an OpenAI key is set, OpenAI is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
AI_DAILY_TOKEN_CAP=2000000  # safety cap (spec: AI credits are capped)

# ─── Payments (UPI) — PENDING provider ─────────────────────────────────────
UPI_PROVIDER_URL=
UPI_MERCHANT_ID=

# ─── Kill switch (spec: organisers can stop any build) ─────────────────────
KILL_SWITCH=0
